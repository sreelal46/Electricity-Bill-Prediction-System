<link rel="stylesheet" href="/css/user-bills.css">

<!-- ===== MODAL ===== -->
<div id="bcModal" class="bc-modal-overlay" onclick="bcBackdrop(event)">
  <div class="bc-modal">

    <button class="bc-modal-close" onclick="bcCloseModal()">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <div class="bc-modal-icon">
      <svg width="26" height="26" fill="none" stroke="#6366f1" stroke-width="2" viewBox="0 0 24 24">
        <rect x="1" y="4" width="22" height="16" rx="2" />
        <line x1="1" y1="10" x2="23" y2="10" />
      </svg>
    </div>

    <h2 class="bc-modal-title">Confirm Payment</h2>
    <p class="bc-modal-sub">Please review the details before confirming your payment.</p>

    <div class="bc-modal-summary">
      <div class="bc-modal-row"><span class="mk">Period</span><span class="mv" id="bcPeriod">—</span></div>
      <div class="bc-modal-row"><span class="mk">Bill No.</span><span class="mv mono" id="bcBillNo">—</span></div>
      <div class="bc-modal-row"><span class="mk">Consumer No.</span><span class="mv mono" id="bcConsumer">—</span></div>
      <div class="bc-modal-row bc-modal-total">
        <span class="mk">Amount Payable</span>
        <span class="bc-modal-amount" id="bcAmount">—</span>
      </div>
    </div>

    <div class="bc-modal-error" id="bcError">Something went wrong. Please try again.</div>

    <div class="bc-modal-actions">
      <button class="bc-cancel-btn" onclick="bcCloseModal()">Cancel</button>
      <button class="bc-confirm-btn" id="bcConfirmBtn" onclick="bcConfirmPayment()">
        <span id="bcConfirmTxt">Confirm Payment</span>
        <svg class="bc-spinner" id="bcSpinner" width="15" height="15" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- ===== TOAST ===== -->
<div class="bc-toast" id="bcToast">
  <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
    <polyline points="20 6 9 17 4 12" />
  </svg>
  Payment confirmed successfully!
</div>
<!-- ===== RECEIPT MODAL ===== -->
<div id="bcReceiptModal" class="bc-modal-overlay" onclick="bcReceiptBackdrop(event)">
  <div class="bc-modal">

    <button class="bc-modal-close" onclick="bcCloseReceipt()">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <div class="bc-modal-icon">
      <svg width="26" height="26" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <polyline points="9 15 11 17 15 13" />
      </svg>
    </div>

    <h2 class="bc-modal-title">Payment Receipt</h2>
    <p class="bc-modal-sub">Bill payment details for your records.</p>

    <div class="bc-modal-summary">
      <div class="bc-modal-row">
        <span class="mk">Period</span>
        <span class="mv" id="rcPeriod">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Consumer No.</span>
        <span class="mv mono" id="rcConsumer">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Bill date</span>
        <span class="mv mono" id="rcBillDate">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Due date</span>
        <span class="mv mono" id="rcDueDate">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Paid on</span>
        <span class="mv mono" id="rcPaidOn">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Payment method</span>
        <span class="mv" id="rcMethod">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Month 1 units</span>
        <span class="mv mono" id="rcM1">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Month 2 units</span>
        <span class="mv mono" id="rcM2">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Total units</span>
        <span class="mv mono" id="rcTotal">—</span>
      </div>

      <!-- Slab breakdown -->
      <div class="bc-modal-row" id="rcSlab1Row">
        <span class="mk">Slab 1 (≤100 units @ ₹3.00)</span>
        <span class="mv mono" id="rcSlab1">—</span>
      </div>
      <div class="bc-modal-row" id="rcSlab2Row">
        <span class="mk">Slab 2 (101–200 @ ₹3.50)</span>
        <span class="mv mono" id="rcSlab2">—</span>
      </div>
      <div class="bc-modal-row" id="rcSlab3Row">
        <span class="mk">Slab 3 (201–400 @ ₹5.00)</span>
        <span class="mv mono" id="rcSlab3">—</span>
      </div>
      <div class="bc-modal-row" id="rcSlab4Row">
        <span class="mk">Slab 4 (>400 @ ₹7.00)</span>
        <span class="mv mono" id="rcSlab4">—</span>
      </div>
      <div class="bc-modal-row">
        <span class="mk">Fixed charge</span>
        <span class="mv mono">₹50.00</span>
      </div>

      <div class="bc-modal-row bc-modal-total">
        <span class="mk">Total paid</span>
        <span class="bc-modal-amount" id="rcAmount">—</span>
      </div>
    </div>

    <div class="bc-modal-actions">
      <button class="bc-cancel-btn" onclick="bcCloseReceipt()">Close</button>
      <button class="bc-receipt-btn-download" onclick="bcDownloadBill(this)" data-id="">
        Download PDF
      </button>
    </div>

  </div>
</div>
<!-- ===== PAGE ===== -->
<div class="container">

  <!-- Header -->
  <div class="bills-page-header">
    <h1 class="bills-page-title">
      <svg width="30" height="30" fill="none" stroke="#8b5cf6" stroke-width="2" viewBox="0 0 24 24">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <line x1="16" y1="13" x2="8" y2="13" />
        <line x1="16" y1="17" x2="8" y2="17" />
      </svg>
      Electricity Bills
    </h1>
    <div class="bills-page-subtitle">
      <span class="bills-pulse-dot"></span>
      Account: KE-2847-5591 &nbsp;·&nbsp; Rahul Menon
    </div>
  </div>

  <!-- Grid -->
  <div class="bills-grid">

    <!-- JAN – FEB 2025 · Unpaid -->
    {{#each bills}}
    <div class="bill-card {{#if (eq this.payment_status 'unpaid')}}bc-unpaid{{else}}bc-paid{{/if}}">

      <div class="bc-top">
        <span class="bc-period {{#if (eq this.payment_status 'unpaid')}}p-unpaid{{else}}p-paid{{/if}}">
          {{this.bill_period}}
        </span>
        {{#if (eq this.payment_status "unpaid")}}
        <span class="bc-status s-unpaid"><span class="bc-dot d-red"></span>Unpaid</span>
        {{else}}
        <span class="bc-status s-paid"><span class="bc-dot d-green"></span>Paid</span>
        {{/if}}
      </div>

      <div class="bc-amount-label">Total Amount</div>
      <div class="bc-amount {{#if (eq this.payment_status 'unpaid')}}a-unpaid{{else}}a-paid{{/if}}">
        ₹{{this.total_bill_rupees}}
      </div>

      <div class="bc-details">
        <div class="bc-row">
          <span class="bc-key">Bill Date</span>
          <span class="bc-val">{{this.bill_generated_date}}</span>
        </div>
        <div class="bc-row">
          <span class="bc-key">Due Date</span>
          <span class="bc-val {{#if (eq this.payment_status 'unpaid')}}bc-due{{/if}}">
            {{this.due_date}}
          </span>
        </div>
        <div class="bc-row">
          <span class="bc-key">Month 1 Used</span>
          <span class="bc-val bc-mono bc-bold">{{this.month1_units}} kWh</span>
        </div>
        <div class="bc-row">
          <span class="bc-key">Month 2 Used</span>
          <span class="bc-val bc-mono bc-bold">{{this.month2_units}} kWh</span>
        </div>
        <div class="bc-row">
          <span class="bc-key">Total Used</span>
          <span class="bc-val bc-mono bc-bold">{{this.total_units}} kWh</span>
        </div>
      </div>

      {{#if (eq this.payment_status "unpaid")}}
      <button class="bc-pay-btn" onclick="bcOpenModal(this)" data-id="{{this.bill_id}}"
        data-period="{{this.bill_period}}" data-billno="{{this.bill_number}}" data-consumerno="KE-2847-5591"
        data-amount="₹{{this.total_bill_rupees}}">
        Pay Now
      </button>
      {{else}}
      <button class="bc-receipt-btn" onclick="bcOpenReceipt(this)" data-id="{{this.bill_id}}"
        data-period="{{this.bill_period}}" data-bill-date="{{this.bill_generated_date}}"
        data-due-date="{{this.due_date}}" data-paid-on="{{this.payment_date}}" data-method="{{this.payment_method}}"
        data-m1="{{this.month1_units}}" data-m2="{{this.month2_units}}" data-total-units="{{this.total_units}}"
        data-amount="{{this.total_bill_rupees}}" data-slab1-units="{{this.slab_breakdown.slab1_units}}"
        data-slab1-amount="{{this.slab_breakdown.slab1_amount}}" data-slab2-units="{{this.slab_breakdown.slab2_units}}"
        data-slab2-amount="{{this.slab_breakdown.slab2_amount}}" data-slab3-units="{{this.slab_breakdown.slab3_units}}"
        data-slab3-amount="{{this.slab_breakdown.slab3_amount}}" data-slab4-units="{{this.slab_breakdown.slab4_units}}"
        data-slab4-amount="{{this.slab_breakdown.slab4_amount}}">
        View Receipt
      </button>
      {{/if}}

    </div>
    {{/each}}


  </div><!-- /bills-grid -->
</div><!-- /container -->

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  let bcCurrentId = null;

  function bcOpenModal(btn) {
    bcCurrentId = btn.dataset.id;
    document.getElementById('bcPeriod').textContent = btn.dataset.period;
    document.getElementById('bcBillNo').textContent = btn.dataset.billno;
    document.getElementById('bcConsumer').textContent = btn.dataset.consumerno;
    document.getElementById('bcAmount').textContent = btn.dataset.amount;
    document.getElementById('bcError').classList.remove('show');
    bcResetBtn();
    document.getElementById('bcModal').classList.add('open');
  }

  function bcCloseModal() {
    document.getElementById('bcModal').classList.remove('open');
    bcCurrentId = null;
  }

  function bcBackdrop(e) {
    if (e.target === document.getElementById('bcModal')) bcCloseModal();
  }

  async function bcConfirmPayment() {
    if (!bcCurrentId) return;

    document.getElementById('bcConfirmTxt').textContent = 'Processing...';
    document.getElementById('bcSpinner').classList.add('show');
    document.getElementById('bcConfirmBtn').disabled = true;
    document.getElementById('bcError').classList.remove('show');

    try {
      await axios.put(`/user/bills/${bcCurrentId}/pay`, {
        status: 'paid',
        paid_at: new Date().toISOString()
      });

      bcCloseModal();
      bcShowToast();

      // Update card UI
      const payBtn = document.querySelector(`[data-id="${bcCurrentId}"]`);
      if (payBtn) {
        const card = payBtn.closest('.bill-card');

        // Period badge → paid
        card.querySelector('.bc-period').className = 'bc-period p-paid';

        // Status badge → paid
        const sb = card.querySelector('.bc-status');
        sb.className = 'bc-status s-paid';
        sb.innerHTML = '<span class="bc-dot d-green"></span>Paid';

        // Amount → paid color
        card.querySelector('.bc-amount').className = 'bc-amount a-paid';

        // Due date → remove red
        const due = card.querySelector('.bc-due');
        if (due) due.className = 'bc-val';

        // Card border → paid
        card.classList.replace('bc-unpaid', 'bc-paid');

        // Swap button
        payBtn.className = 'bc-receipt-btn';
        payBtn.textContent = 'Paid ✓';
        payBtn.disabled = true;
        payBtn.removeAttribute('onclick');
      }

    } catch (err) {
      const el = document.getElementById('bcError');
      el.textContent = err.response?.data?.message || 'Payment failed. Please try again.';
      el.classList.add('show');
      bcResetBtn();
    }
  }

  function bcResetBtn() {
    document.getElementById('bcConfirmTxt').textContent = 'Confirm Payment';
    document.getElementById('bcSpinner').classList.remove('show');
    document.getElementById('bcConfirmBtn').disabled = false;
  }

  function bcShowToast() {
    const t = document.getElementById('bcToast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3500);
  }

  function bcOpenReceipt(btn) {
    const d = btn.dataset;

    // ← set the bill ID onto the modal's download button
    document.querySelector('.bc-receipt-btn-download').dataset.id = d.id;

    document.getElementById('rcPeriod').textContent = d.period;
    document.getElementById('rcConsumer').textContent = 'KE-2847-5591';
    document.getElementById('rcBillDate').textContent = d.billDate;
    document.getElementById('rcDueDate').textContent = d.dueDate;
    document.getElementById('rcPaidOn').textContent = d.paidOn || '—';
    document.getElementById('rcMethod').textContent = d.method || '—';
    document.getElementById('rcM1').textContent = d.m1 + ' kWh';
    document.getElementById('rcM2').textContent = d.m2 + ' kWh';
    document.getElementById('rcTotal').textContent = d.totalUnits + ' kWh';
    document.getElementById('rcAmount').textContent = '₹' + d.amount;

    const setSlabRow = (rowId, valId, units, amount) => {
      const row = document.getElementById(rowId);
      if (parseFloat(units) > 0) {
        row.style.display = '';
        document.getElementById(valId).textContent = units + ' kWh = ₹' + amount;
      } else {
        row.style.display = 'none';
      }
    };

    setSlabRow('rcSlab1Row', 'rcSlab1', d.slab1Units, d.slab1Amount);
    setSlabRow('rcSlab2Row', 'rcSlab2', d.slab2Units, d.slab2Amount);
    setSlabRow('rcSlab3Row', 'rcSlab3', d.slab3Units, d.slab3Amount);
    setSlabRow('rcSlab4Row', 'rcSlab4', d.slab4Units, d.slab4Amount);

    document.getElementById('bcReceiptModal').classList.add('open');
  }



  function bcCloseReceipt() {
    document.getElementById('bcReceiptModal').classList.remove('open');
  }

  function bcReceiptBackdrop(e) {
    if (e.target === document.getElementById('bcReceiptModal')) bcCloseReceipt();
  }

  async function bcDownloadBill(btn) {
    const billId = btn.dataset.id;
    // Show loading state on button
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Generating...';

    try {
      try {
        const response = await axios.get(`/user/bills/${billId}/download`, {
          responseType: 'blob'
        });

        // ✓ reaches here only after doc.end() completes on backend
        // response.status === 200, response.data === the PDF blob

        const blob = new Blob([response.data], { type: 'application/pdf' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bill-${billId}.pdf`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);

        // optional — show toast or update button
        btn.textContent = 'Downloaded';

      } catch (err) {
        // ✓ reaches here if backend returns 404 or 500
        // but note: err.response.data is a blob here, not JSON
        // so parse it like this:
        const text = await err.response?.data?.text();
        const json = JSON.parse(text || '{}');
        alert(json.message || 'Failed to download. Please try again.');
      }
    } catch (err) {
      const msg = err.response?.data?.message || 'Failed to download. Please try again.';
      alert(msg);
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }

</script>